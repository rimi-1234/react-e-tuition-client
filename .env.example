# API origin (no trailing slash, no /api/v1 — the client adds it)
VITE_API_URL=http://localhost:3000

# Free ImgBB key for image uploads (https://api.imgbb.com/)
VITE_IMAGE_HOST_KEY=

# Optional: override the bundled Firebase web config
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Contact channels for the floating contact button
VITE_CONTACT_PHONE=+8801700000000
VITE_CONTACT_PHONE_LABEL=+880 1700-000000
VITE_CONTACT_WHATSAPP=8801700000000
VITE_CONTACT_MESSENGER=edurock
VITE_CONTACT_EMAIL=hello@edurock.app
